local Players = game:GetService("Players")
local Run = game:GetService("RunService")

local Cooldown = 3
local Last = 0

Run.Heartbeat:Connect(function()
	local PlayerSheriff = nil
	local Murderer = nil

	local LPlayer = game.Players.LocalPlayer
	local LCharacter = LPlayer.Character
	if not LCharacter then return end
	local LBackpack = LPlayer.Backpack

	if (LBackpack and LBackpack:FindFirstChild("Gun")) or (LCharacter and LCharacter:FindFirstChild("Gun")) then
		PlayerSheriff = true
	end


	if PlayerSheriff == nil then return end

	for _, v in Players:GetPlayers() do
		local Character = v.Character
		if not Character then return end	
		local Backpack = v.Backpack
		if not Backpack then return end
		local Root = Character:FindFirstChild("HumanoidRootPart") or Character:FindFirstChild("UpperTorso")
		if not Root then return end


		if (Backpack and Backpack:FindFirstChild("Knife")) or (Character and Character:FindFirstChild("Knife")) then
			Murderer = Root.CFrame
		end

	end

	if Murderer == nil then return end

	if not LCharacter:FindFirstChild("Gun") then return end


	if os.clock() - Last < Cooldown then return end
	Last = os.clock()


	local args = {
		Murderer * CFrame.new(0, 0, -5),
		Murderer
	}
	game:GetService("Players").LocalPlayer.Character:WaitForChild("Gun"):WaitForChild("Shoot"):FireServer(unpack(args))



end)
